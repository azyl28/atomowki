  .timeline-fancy-item .tf-dot,
  .timeline-fancy-item:nth-child(even) .tf-dot{grid-column:1;grid-row:1;justify-content:flex-start}
  .timeline-fancy-item .tf-dot span{font-size:.85rem;padding:.2rem .5rem}
  .coach-grid{grid-template-columns:1fr 1fr}
  .national-grid{grid-template-columns:1fr 1fr}
  .sponsor-pro-grid{grid-template-columns:1fr 1fr}
  .season-grid{grid-template-columns:1fr}
}
