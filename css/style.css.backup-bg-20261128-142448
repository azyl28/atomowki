    font-size: 1.8rem;
    color: #fff;
    margin: 0;
    line-height: 1;
}

/* Strzalki nawigacji */
.carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 54px; height: 54px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    border: none;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: transform 0.2s, background 0.2s;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}
.carousel-nav:hover {
    transform: translateY(-50%) scale(1.1);
    background: var(--v3-pink);
    color: #fff;
}
.carousel-nav.prev { left: 0; }
.carousel-nav.next { right: 0; }

/* Responsywnosc wachlarza */
@media (max-width: 768px) {
    .players-carousel-wrapper { height: 450px; }
    .players-carousel-track { width: 260px; height: 380px; }
    .player-card-fan.is-prev { transform: translate(calc(-50% - 100px), -50%) scale(0.8); }
    .player-card-fan.is-next { transform: translate(calc(-50% + 100px), -50%) scale(0.8); }
    .player-card-fan.is-hidden-left, .player-card-fan.is-hidden-right { opacity: 0; }
    .carousel-nav { width: 40px; height: 40px; font-size: 1.2rem; }
    .carousel-nav.prev { left: -10px; }
    .carousel-nav.next { right: -10px; }
