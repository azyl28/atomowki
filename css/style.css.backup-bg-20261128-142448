/* ============ RESET & TOKENS ============ */
*,*::before,*::after{box-sizing:border-box}
:root{
  --black:#0b0b0d;
  --graphite:#15161a;
  --graphite-2:#1d1f24;
  --red:#e10600;
  --red-dark:#b00400;
  --white:#ffffff;
  --gray-1:#c9ccd3;
  --gray-2:#8b8f99;
  --gray-3:#4a4d55;
  --radius:14px;
  --radius-sm:8px;
  --shadow:0 20px 50px rgba(0,0,0,.45);
  --font-display:'Barlow Condensed',system-ui,sans-serif;
  --font-body:'Inter',system-ui,sans-serif;
  --container:1200px;
  --header-h:76px;
}
html{scroll-behavior:smooth}
body{
  margin:0;font-family:var(--font-body);background:var(--black);color:var(--white);
  line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
ul{list-style:none;margin:0;padding:0}
h1,h2,h3,h4{font-family:var(--font-display);line-height:1.05;letter-spacing:.02em;margin:0 0 .6em;text-transform:uppercase}
p{margin:0 0 1em;color:var(--gray-1)}
code{background:var(--graphite-2);padding:.15em .4em;border-radius:5px;font-size:.9em;color:#ffd7d5}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.container{width:min(100% - 2.5rem,var(--container));margin-inline:auto}
.skip-link{position:absolute;left:-9999px;top:0;background:var(--red);color:#fff;padding:.7rem 1rem;z-index:200}
.skip-link:focus{left:1rem;top:1rem}

/* ============ BUTTONS ============ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:var(--font-display);font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.85rem 1.5rem;border-radius:var(--radius-sm);border:2px solid transparent;cursor:pointer;transition:transform .2s,background .2s,color .2s,border-color .2s,box-shadow .2s;font-size:.95rem}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:var(--red);color:#fff;box-shadow:0 10px 25px rgba(225,6,0,.35)}
.btn-primary:hover{background:var(--red-dark)}
.btn-outline{border-color:rgba(255,255,255,.5);color:#fff;background:transparent}
.btn-outline:hover{background:#fff;color:var(--black);border-color:#fff}
.btn-ghost{color:var(--white);padding-left:0}
.btn-ghost:hover{color:var(--red)}
.btn-lg{padding:1.1rem 2rem;font-size:1.05rem}

/* ============ HERO ============ */
.hero{position:relative;min-height:calc(100vh - var(--header-h));display:flex;align-items:center;overflow:hidden}
.hero-media{position:absolute;inset:0}
.hero-placeholder{position:absolute;inset:0;display:grid;place-items:center;gap:.3rem;text-align:center;background:
  radial-gradient(circle at 30% 30%,rgba(225,6,0,.25),transparent 55%),
  repeating-linear-gradient(45deg,#111 0 22px,#0d0d0f 22px 44px);
}
.hero-placeholder span{font-family:var(--font-display);font-size:clamp(1.1rem,3vw,1.8rem);letter-spacing:.2em;color:rgba(255,255,255,.35)}
.hero-placeholder small{color:rgba(255,255,255,.25);letter-spacing:.1em}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,11,13,.95) 0%,rgba(11,11,13,.78) 45%,rgba(11,11,13,.45) 100%)}
.hero-content{position:relative;z-index:2;padding-block:4rem}
.hero-kicker{font-size:.85rem;letter-spacing:.3em;text-transform:uppercase;color:var(--red);font-weight:700}
.hero-title{font-size:clamp(2.8rem,8vw,6.5rem);letter-spacing:.01em;margin:.3em 0}
.hero-title .accent{color:var(--red)}
.hero-motto{font-family:var(--font-display);font-size:clamp(1.1rem,2.4vw,1.7rem);letter-spacing:.35em;color:var(--white);margin-bottom:1rem}
.hero-desc{max-width:620px;font-size:1.02rem}
.hero-actions{display:flex;gap:.9rem;flex-wrap:wrap;margin:1.8rem 0}
.hero-stats{display:flex;gap:2.2rem;flex-wrap:wrap;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.12)}
.hero-stats li{display:flex;flex-direction:column}
.hero-stats strong{font-family:var(--font-display);font-size:1.5rem;color:var(--white)}
.hero-stats span{font-size:.78rem;color:var(--gray-2);letter-spacing:.08em;text-transform:uppercase}
.scroll-hint{position:absolute;left:50%;bottom:1.4rem;transform:translateX(-50%);width:26px;height:42px;border:2px solid rgba(255,255,255,.35);border-radius:16px;z-index:2}
.scroll-hint span{position:absolute;left:50%;top:8px;width:4px;height:8px;margin-left:-2px;background:var(--red);border-radius:2px;animation:scrollDot 1.6s infinite}

/* ============ SECTIONS ============ */
.section{padding:clamp(3.5rem,7vw,6rem) 0;position:relative}
.section-alt{background:var(--graphite)}
.section-kicker{font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:.4rem}
.section-title{font-size:clamp(1.8rem,4vw,3rem)}
.section-lead{max-width:720px;color:var(--gray-1)}
.text-center{text-align:center}
.hint{font-size:.8rem;color:var(--gray-2);margin-top:1rem}
.two-col{display:grid;grid-template-columns:1.2fr .8fr;gap:3rem;align-items:start}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}

/* mini timeline */
.mini-timeline li{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.08)}
.mini-timeline span{font-family:var(--font-display);font-size:1.3rem;color:var(--red);min-width:70px}
.mini-timeline p{margin:0;font-size:.92rem}
.timeline{position:relative;padding-left:1rem}
.timeline::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(var(--red),transparent)}
.timeline li{position:relative;display:grid;grid-template-columns:100px 1fr;gap:1.4rem;padding:1.4rem 0 1.4rem 1.5rem}
.timeline .year{font-family:var(--font-display);font-size:1.5rem;color:var(--red);position:relative}
.timeline .year::before{content:"";position:absolute;left:-1.98rem;top:.55rem;width:12px;height:12px;border-radius:50%;background:var(--red);box-shadow:0 0 0 4px rgba(225,6,0,.2)}
.timeline h3{margin-bottom:.2em}
.timeline p{margin:0;font-size:.95rem}

/* info cards */
.info-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);padding:1.8rem}
.info-card h2,.info-card h3{margin-top:0}
.stats-list{display:grid;gap:1rem}
.stats-list li{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;border-bottom:1px dashed rgba(255,255,255,.12);padding-bottom:.7rem}
.stats-list strong{font-family:var(--font-display);font-size:1.25rem;color:var(--white)}
.stats-list span{color:var(--gray-2);font-size:.85rem}
.check-list{margin-top:.6rem;display:grid;gap:.45rem}
.check-list li{padding-left:1.4rem;position:relative;font-size:.92rem;color:var(--gray-1)}
.check-list li::before{content:"\2714";position:absolute;left:0;color:var(--red)}

/* CTA */
.section-cta{padding-block:3rem}
.cta-box{display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;background:linear-gradient(120deg,var(--red-dark),var(--red));border-radius:var(--radius);padding:2.4rem;box-shadow:var(--shadow)}
.cta-box .section-title{color:#fff;margin-bottom:.3em}
.cta-box p{color:rgba(255,255,255,.85)}
.cta-box .btn-primary{background:var(--black)}
.cta-box .btn-primary:hover{background:#000}

/* values */
.values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
.value-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);padding:1.6rem;transition:transform .25s,border-color .25s}
.value-card:hover{transform:translateY(-4px);border-color:var(--red)}
.value-card h3{color:var(--white);font-size:1.25rem}
.value-card p{font-size:.9rem;margin:0}

/* news */
.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.news-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,border-color .25s}
.news-card:hover{transform:translateY(-4px);border-color:rgba(225,6,0,.6)}
.news-thumb{aspect-ratio:16/10;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:rgba(255,255,255,.3);font-size:.75rem;letter-spacing:.15em;text-transform:uppercase}
.news-body{padding:1.2rem 1.3rem 1.4rem;display:flex;flex-direction:column;gap:.5rem;flex:1}
.news-meta{display:flex;gap:.7rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--gray-2)}
.news-cat{color:var(--red);font-weight:700}
.news-body h3{font-size:1.15rem;margin:0}
.news-body p{font-size:.9rem;margin:0}
.news-body .btn{margin-top:auto;align-self:flex-start}

/* sponsors */
.sponsor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2rem}
.sponsor-slot{border:1px dashed rgba(255,255,255,.2);border-radius:var(--radius);min-height:110px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;color:var(--gray-1);font-family:var(--font-display);font-size:1.2rem;letter-spacing:.1em;background:rgba(255,255,255,.02)}
.sponsor-slot small{font-family:var(--font-body);font-size:.7rem;color:var(--gray-2);letter-spacing:.05em}

/* page hero */
.page-hero{padding:4.5rem 0 2.5rem;background:
  radial-gradient(900px 300px at 15% 0%,rgba(225,6,0,.22),transparent 60%),
  linear-gradient(180deg,var(--graphite) 0%,var(--black) 100%);
  border-bottom:1px solid rgba(255,255,255,.06)}
.page-title{font-size:clamp(2.2rem,6vw,4rem)}
.page-lead{max-width:680px}

/* tabs & filters */
.tabs,.filter-bar{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2rem}
.tab,.filter{background:var(--graphite-2);border:1px solid rgba(255,255,255,.1);color:var(--gray-1);padding:.6rem 1.1rem;border-radius:999px;cursor:pointer;font-family:var(--font-display);letter-spacing:.08em;text-transform:uppercase;font-size:.85rem;transition:all .2s}
.tab:hover,.filter:hover{border-color:var(--red);color:#fff}
.tab.active,.filter.active{background:var(--red);border-color:var(--red);color:#fff}

/* players */
.players-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.3rem}
.player-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.07);border-radius:var(--radius);overflow:hidden;cursor:pointer;text-align:left;padding:0;color:inherit;font:inherit;transition:transform .25s,border-color .25s}
.player-card:hover{transform:translateY(-5px);border-color:var(--red)}
.player-photo{aspect-ratio:3/4;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;position:relative;color:rgba(255,255,255,.3);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;text-align:center;padding:.5rem}
.player-number{position:absolute;top:.6rem;right:.6rem;background:var(--red);font-family:var(--font-display);font-weight:800;font-size:1.2rem;width:44px;height:44px;display:grid;place-items:center;border-radius:50%}
.player-info{padding:1rem 1.1rem 1.2rem}
.player-info h3{font-size:1.1rem;margin:0 0 .2em}
.player-pos{font-size:.75rem;color:var(--red);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

/* training */
.training-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.training-card{background:var(--graphite-2);border-left:4px solid var(--red);border-radius:var(--radius-sm);padding:1.2rem 1.4rem}
.training-card h3{margin:0 0 .3em;font-size:1.15rem}
.training-card p{margin:0;font-size:.9rem}

/* FAQ */
.faq{display:grid;gap:.7rem;max-width:860px}
.faq-item{border:1px solid rgba(255,255,255,.09);border-radius:var(--radius-sm);background:var(--graphite-2);overflow:hidden}
.faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:1rem;background:none;border:0;color:#fff;padding:1rem 1.2rem;cursor:pointer;font-family:var(--font-body);font-size:1rem;font-weight:600;text-align:left}
.faq-q::after{content:"+";font-family:var(--font-display);font-size:1.4rem;color:var(--red);transition:transform .3s}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;padding:0 1.2rem}
.faq-a p{padding-bottom:1rem;margin:0;font-size:.92rem}

/* matches */
.match-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.match-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:1.4rem}
.match-teams{display:flex;justify-content:space-between;align-items:center;gap:.6rem;font-family:var(--font-display);font-size:1.2rem;letter-spacing:.03em;margin-bottom:.8rem}
.match-vs{color:var(--red);font-size:.85rem}
.match-score{font-family:var(--font-display);font-size:1.7rem;color:#fff;text-align:center;margin-bottom:.6rem}
.match-info{display:grid;gap:.25rem;font-size:.82rem;color:var(--gray-2);border-top:1px solid rgba(255,255,255,.08);padding-top:.8rem}
.match-info strong{color:var(--gray-1);font-weight:600}
.empty-note{border:1px dashed rgba(255,255,255,.2);padding:1.2rem;border-radius:var(--radius);color:var(--gray-2);font-size:.9rem}

/* league table */
.table-wrap{overflow-x:auto;border-radius:var(--radius);border:1px solid rgba(255,255,255,.08)}
.league-table{width:100%;border-collapse:collapse;min-width:520px}
.league-table th,.league-table td{padding:.85rem 1rem;text-align:left;border-bottom:1px solid rgba(255,255,255,.06);font-size:.9rem}
.league-table th{background:var(--graphite-2);font-family:var(--font-display);letter-spacing:.08em;text-transform:uppercase;color:var(--gray-1);font-size:.8rem}
.league-table tr:hover td{background:rgba(225,6,0,.06)}

/* successes */
.success-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem}
.success-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);overflow:hidden}
.success-photo{aspect-ratio:16/9;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:rgba(255,255,255,.3);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
.success-body{padding:1.2rem 1.3rem 1.4rem}
.success-meta{display:flex;gap:.7rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--gray-2);margin-bottom:.5rem}
.success-meta .cat{color:var(--red);font-weight:700}
.success-body h3{font-size:1.2rem;margin:0 0 .3em}
.success-body p{font-size:.9rem;margin:0}

/* gallery */
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem}
.gallery-item{position:relative;aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);border:0;cursor:pointer;padding:0;display:grid;place-items:center;color:rgba(255,255,255,.3);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;text-align:center;transition:transform .25s}
.gallery-item:hover{transform:scale(1.03)}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.gallery-item:hover img{transform:scale(1.08)}
.gallery-item .gallery-cat{position:absolute;left:.4rem;bottom:.4rem;background:rgba(11,11,13,.8);color:var(--red);font-size:.62rem;padding:.2rem .45rem;border-radius:4px;letter-spacing:.08em}
.lightbox{position:fixed;inset:0;z-index:300;background:rgba(5,5,7,.96);display:none;place-items:center;padding:2rem}
.lightbox.open{display:grid}
.lightbox-figure{max-width:min(1000px,92vw);text-align:center}
.lightbox-image{min-height:320px;border-radius:var(--radius-sm);display:grid;place-items:center;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);color:rgba(255,255,255,.35);font-size:.85rem;letter-spacing:.1em;text-transform:uppercase;padding:2rem}
.lightbox-image img{max-height:70vh;width:auto;margin:auto}
.lightbox figcaption{color:var(--gray-1);margin-top:.9rem;font-size:.9rem}
.lightbox-close{position:absolute;top:1rem;right:1.2rem;background:none;border:0;color:#fff;font-size:2.4rem;cursor:pointer;line-height:1}
.lightbox-prev,.lightbox-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.06);border:0;color:#fff;font-size:2.4rem;width:56px;height:56px;border-radius:50%;cursor:pointer;display:grid;place-items:center}
.lightbox-prev{left:1rem}.lightbox-next{right:1rem}
.lightbox-prev:hover,.lightbox-next:hover{background:var(--red)}

/* contact */
.contact-list{display:grid;gap:.8rem;margin-bottom:1.6rem}
.contact-list li{font-size:.95rem}
.contact-list strong{color:var(--white)}
.contact-list small{color:var(--gray-2)}
.map-placeholder{aspect-ratio:16/9;border:1px dashed rgba(255,255,255,.25);border-radius:var(--radius);display:grid;place-items:center;text-align:center;color:var(--gray-2);font-family:var(--font-display);letter-spacing:.12em;font-size:.9rem}
.contact-form{display:grid;gap:.9rem}
.contact-form label{display:grid;gap:.35rem;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gray-1)}
.contact-form input,.contact-form select,.contact-form textarea{background:var(--graphite-2);border:1px solid rgba(255,255,255,.14);border-radius:var(--radius-sm);padding:.8rem .9rem;color:#fff;font:inherit;transition:border-color .2s}
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--red);outline:none}
.contact-form .checkbox{display:flex;align-items:flex-start;gap:.6rem;text-transform:none;letter-spacing:0;font-size:.82rem;color:var(--gray-1)}
.contact-form .checkbox input{width:auto}
.form-note{font-size:.85rem;min-height:1.2em}
.form-note.ok{color:#5dd17a}.form-note.err{color:#ff6b63}

/* modal */
.modal{position:fixed;inset:0;z-index:250;display:none}
.modal.open{display:grid;place-items:center}
.modal-backdrop{position:absolute;inset:0;background:rgba(5,5,7,.8);backdrop-filter:blur(4px)}
.modal-content{position:relative;background:var(--graphite);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius);width:min(640px,92vw);max-height:88vh;overflow:auto;padding:2rem;z-index:1}
.modal-close{position:absolute;top:.6rem;right:.9rem;background:none;border:0;color:#fff;font-size:2rem;cursor:pointer;line-height:1}
.modal-body h2{color:#fff;margin-bottom:.4em}
.modal-photo{aspect-ratio:16/9;border-radius:var(--radius-sm);background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:var(--gray-2);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem}

/* back to top */
.back-to-top{position:fixed;right:1.2rem;bottom:1.2rem;z-index:150;width:46px;height:46px;border-radius:50%;border:0;background:var(--red);color:#fff;font-size:1.3rem;cursor:pointer;opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .3s,transform .3s}
.back-to-top.show{opacity:1;pointer-events:auto;transform:none}

/* footer */
.site-footer{background:#08080a;border-top:1px solid rgba(255,255,255,.07);padding-top:3rem}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:2rem;padding-bottom:2.5rem}
.footer-brand p{font-size:.9rem;margin-top:.8rem}
.footer-grid h4{font-size:.95rem;letter-spacing:.12em;color:#fff;margin-bottom:1rem}
.footer-links{display:grid;gap:.45rem}
.footer-links a{color:var(--gray-2);font-size:.88rem;transition:color .2s}
.footer-links a:hover{color:var(--red)}
.footer-bottom{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1.2rem 0;border-top:1px solid rgba(255,255,255,.06);font-size:.78rem;color:var(--gray-2)}

/* hero photo */
.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}

/* ============================================================
   MODUL B — ROZBUDOWA (historia, reprezentacja, sponsorzy, sezon)
   ============================================================ */

/* ---------- OŚ CZASU Z FOTOGRAFIAMI ---------- */
.timeline-fancy{position:relative;padding-left:0;margin-top:2rem}
.timeline-fancy::before{content:"";position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(var(--red),rgba(225,6,0,.1));transform:translateX(-50%)}
.timeline-fancy-item{position:relative;display:grid;grid-template-columns:1fr 80px 1fr;gap:1rem;align-items:center;padding:1.5rem 0}
.timeline-fancy-item .tf-content{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:1.4rem;transition:border-color .3s,transform .3s}
.timeline-fancy-item:hover .tf-content{border-color:var(--red);transform:translateY(-3px)}
.timeline-fancy-item .tf-content h3{margin:0 0 .4em;font-size:1.15rem;color:#fff}
.timeline-fancy-item .tf-content p{margin:0;font-size:.92rem;color:var(--gray-1)}
.timeline-fancy-item .tf-photo{aspect-ratio:4/3;border-radius:var(--radius-sm);overflow:hidden;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:var(--gray-2);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;text-align:center;padding:.5rem}
.timeline-fancy-item .tf-photo img{width:100%;height:100%;object-fit:cover}
.timeline-fancy-item .tf-dot{position:relative;display:grid;place-items:center}
.timeline-fancy-item .tf-dot span{font-family:var(--font-display);font-weight:800;font-size:1.05rem;color:var(--red);background:var(--black);padding:.35rem .8rem;border:2px solid var(--red);border-radius:999px;white-space:nowrap;z-index:1}
.timeline-fancy-item:nth-child(odd) .tf-content{grid-column:1}
.timeline-fancy-item:nth-child(odd) .tf-photo{grid-column:3}
.timeline-fancy-item:nth-child(even) .tf-content{grid-column:3}
.timeline-fancy-item:nth-child(even) .tf-photo{grid-column:1}
.timeline-fancy-item:nth-child(even) .tf-dot{grid-column:2;grid-row:1}

/* ---------- KARTY TRENERÓW / KAPITANÓW ---------- */
.coach-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem;margin-top:2rem}
.coach-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);overflow:hidden;transition:transform .3s,border-color .3s}
.coach-card:hover{transform:translateY(-5px);border-color:var(--red)}
.coach-photo{aspect-ratio:1;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:var(--gray-2);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}
.coach-photo img{width:100%;height:100%;object-fit:cover}
.coach-body{padding:1.2rem 1.3rem 1.4rem}
.coach-body h3{margin:0 0 .2em;font-size:1.15rem;color:#fff}
.coach-role{font-size:.75rem;color:var(--red);text-transform:uppercase;letter-spacing:.12em;font-weight:700;margin-bottom:.6rem;display:block}
.coach-note{font-size:.85rem;color:var(--gray-2);margin:0}

/* ---------- REPREZENTACJA POLSKI ---------- */
.national-hero{background:linear-gradient(135deg,rgba(225,6,0,.15),transparent 60%);border:1px solid rgba(225,6,0,.35);border-radius:var(--radius);padding:2rem;margin-bottom:2rem}
.national-hero h2{margin:0 0 .3em}
.national-hero p{margin:0;color:var(--gray-1)}
.national-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem}
.national-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);overflow:hidden;position:relative;transition:transform .3s,border-color .3s}
.national-card:hover{transform:translateY(-5px);border-color:var(--red)}
.national-card .nat-photo{aspect-ratio:3/4;background:repeating-linear-gradient(45deg,#1a1c21 0 14px,#141619 14px 28px);display:grid;place-items:center;color:var(--gray-2);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;text-align:center;padding:.5rem}
.national-card .nat-photo img{width:100%;height:100%;object-fit:cover}
.national-card .nat-badge{position:absolute;top:.7rem;left:.7rem;background:var(--red);color:#fff;font-family:var(--font-display);font-weight:800;font-size:.72rem;letter-spacing:.1em;padding:.25rem .55rem;border-radius:4px}
.national-card .nat-body{padding:1.1rem 1.2rem 1.3rem}
.national-card .nat-body h3{margin:0 0 .2em;font-size:1.05rem;color:#fff}
.national-card .nat-year{font-size:.72rem;color:var(--red);letter-spacing:.12em;font-weight:700;text-transform:uppercase}
.national-card .nat-note{font-size:.83rem;color:var(--gray-2);margin:.5rem 0 0}

/* ---------- SPONSORZY PRO ---------- */
.sponsor-pro-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2rem}
.sponsor-pro{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:1.4rem 1rem;text-align:center;transition:transform .25s,border-color .25s;min-height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.4rem}
.sponsor-pro:hover{transform:translateY(-4px);border-color:var(--red)}
.sponsor-pro .sp-name{font-family:var(--font-display);font-weight:800;font-size:1.05rem;letter-spacing:.06em;color:#fff;text-transform:uppercase}
.sponsor-pro .sp-role{font-size:.72rem;color:var(--gray-2);letter-spacing:.08em;text-transform:uppercase}
.sponsor-pro .sp-status{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .55rem;border-radius:999px;margin-top:.4rem;font-weight:700}
.sp-status.ok{background:rgba(93,209,122,.15);color:#5dd17a;border:1px solid rgba(93,209,122,.4)}
.sp-status.pending{background:rgba(255,180,0,.12);color:#ffb400;border:1px solid rgba(255,180,0,.35)}

/* ---------- SEZON 2026/2027 ---------- */
.season-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.4rem;margin-top:2rem}
.season-card{background:var(--graphite-2);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:1.6rem;border-top:4px solid var(--red)}
.season-card h3{margin:0 0 .2em;font-size:1.2rem}
.season-meta{display:flex;gap:1rem;flex-wrap:wrap;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--gray-2);margin-bottom:1rem}
.season-meta .place{color:var(--red);font-weight:700}
.season-match{display:flex;justify-content:space-between;align-items:center;gap:.6rem;padding:.55rem 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:.9rem}
.season-match:last-child{border-bottom:0}
.season-match .score{font-family:var(--font-display);font-weight:800;color:#fff;font-size:1rem}
.season-match .win{color:#5dd17a}
.season-match .loss{color:#ff6b63}
.season-note{margin-top:1rem;font-size:.8rem;color:var(--gray-2);border-top:1px dashed rgba(255,255,255,.1);padding-top:.8rem}

/* ---------- RESPONSIVE ---------- */
@media (max-width:860px){
  .timeline-fancy::before{left:20px}
  .timeline-fancy-item{grid-template-columns:40px 1fr;gap:.8rem}
  .timeline-fancy-item .tf-content,
  .timeline-fancy-item:nth-child(odd) .tf-content,
  .timeline-fancy-item:nth-child(even) .tf-content{grid-column:2}
  .timeline-fancy-item .tf-photo,
  .timeline-fancy-item:nth-child(odd) .tf-photo,
