/* ============================================================
   DRUZYNA - KARTY KOLEKCJONERSKIE (v2 - profesjonalne)
   Dodane automatycznie. Nie usuwac starej sekcji players.
   ============================================================ */
:root {
    --accent-pink: #ff2d78;
    --accent-purple: #a855f7;
    --accent-gradient: linear-gradient(135deg, #ff2d78 0%, #a855f7 100%);
    --card-bg: #14151a;
    --card-bg-2: #1d1f26;
    --card-radius: 20px;
    --card-shadow: 0 20px 60px rgba(0,0,0,0.6);
    --card-shadow-hover: 0 30px 80px rgba(255,45,120,0.25);
}

/* --- Sekcja glowna --- */
.players-section {
    padding: 4rem 0 6rem;
    position: relative;
    overflow: hidden;
}

.players-section::before {
    content: "";
    position: absolute;
    top: -200px; left: -100px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(255,45,120,0.15), transparent 70%);
    pointer-events: none;
    z-index: 0;
}
.players-section::after {
    content: "";
    position: absolute;
    bottom: -200px; right: -100px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(168,85,247,0.12), transparent 70%);
    pointer-events: none;
    z-index: 0;
}

.players-section .container { position: relative; z-index: 1; }

/* --- Zakladki kategorii --- */
.players-tabs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin: 2.5rem 0 3rem;
}

.players-tab {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--gray-1);
    padding: 0.85rem 2rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.players-tab::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent-gradient);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
}

.players-tab:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.3);
    transform: translateY(-2px);
}

.players-tab.active {
    color: #fff;
    border-color: transparent;
    box-shadow: 0 8px 30px rgba(255,45,120,0.4);
}
.players-tab.active::before { opacity: 1; }

/* --- Siatka kart --- */
.players-grid-v2 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
}

/* --- Karta zawodniczki --- */
.player-card-v2 {
    position: relative;
    background: var(--card-bg);
    border-radius: var(--card-radius);
    overflow: hidden;
