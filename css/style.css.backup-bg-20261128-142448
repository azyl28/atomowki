}
.hero-text-box { max-width: 650px; }

.hero-kicker {
  font-size: 0.8rem; letter-spacing: 0.3em; text-transform: uppercase;
  color: #fff; margin-bottom: 1rem; font-weight: 600;
  display: flex; align-items: center; gap: 0.5rem;
}
.hero-kicker::after {
  content: ""; height: 1px; width: 40px; background: var(--red); display: inline-block;
}

/* 3. Główny napis ATOMÓWKI 2 RUGBY */
.hero-title {
  font-family: 'Bebas Neue', var(--font-display), sans-serif !important;
  font-size: clamp(4rem, 8vw, 7.5rem);
  line-height: 0.9;
  margin: 0 0 0.5rem;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  /* Lekki efekt grunge/zużycia na tekście */
  text-shadow: 2px 2px 0px rgba(0,0,0,0.5);
}
.hero-title .accent {
  color: var(--red);
}

/* 4. Podtytuł (kursywa, czerwony) */
.hero-subtitle {
  font-family: 'Bebas Neue', var(--font-display), sans-serif !important;
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  color: var(--red);
  font-style: italic;
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
  text-shadow: 0 4px 15px rgba(225,6,0,0.4);
}

/* 5. Motto */
.hero-motto {
  font-family: var(--font-body);
  font-size: 0.9rem; letter-spacing: 0.4em;
  color: #d1d5db; margin-bottom: 3rem;
  font-weight: 600; text-transform: uppercase;
}

/* 6. NOWE PRZYCISKI (Ukośne, z poświatą) */
.hero-actions {
  display: flex; gap: 1.5rem; flex-wrap: wrap;
}
.btn-hero {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 1rem 2rem;
  font-family: var(--font-body); font-size: 0.8rem;
  font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  text-decoration: none;
  transform: skewX(-15deg); /* Efekt ukośnych krawędzi */
  transition: all 0.3s ease;
  border: none;
}
.btn-hero > * { transform: skewX(15deg); } /* Prostowanie tekstu w środku */

.btn-hero-primary {
  background: var(--red); color: #fff;
  box-shadow: 0 0 20px rgba(225, 6, 0, 0.4);
}
.btn-hero-primary:hover {
  background: #b00400;
  transform: skewX(-15deg) translateY(-3px);
  box-shadow: 0 0 30px rgba(225, 6, 0, 0.7);
}

.btn-hero-outline {
  background: transparent; color: #fff;
  border: 1px solid rgba(255,255,255,0.4);
  backdrop-filter: blur(5px);
}
.btn-hero-outline:hover {
  background: rgba(255,255,255,0.1);
  border-color: #fff;
  transform: skewX(-15deg) translateY(-3px);
}

/* 7. Nawigacja slidera (Strzałki i kropki) */
.hero-slider-nav {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 1.5rem;
  z-index: 3;
}
.slider-arrow {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.3);
  color: #fff;
  width: 40px; height: 40px;
  border-radius: 50%;
  font-size: 1.5rem;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: all 0.3s;
}
.slider-arrow:hover {
  background: var(--red);
  border-color: var(--red);
}
.slider-dots {
  display: flex; gap: 0.5rem;
}
.dot {
  width: 30px; height: 3px;
  background: rgba(255,255,255,0.3);
  border-radius: 2px;
  transition: all 0.3s;
}
.dot.active {
  background: var(--red);
  width: 50px;
}

/* 8. Responsywność (Mobile) */
@media (max-width: 900px) {
  .hero-content-wrapper { padding-left: 1.5rem !important; }
  .hero-title { font-size: 3.5rem; }
  .hero-actions { flex-direction: column; align-items: stretch; gap: 1rem; }
  .hero-slider-nav { bottom: 1rem; }
}

