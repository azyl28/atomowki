}

.players-carousel-track {
    position: relative;
    width: 320px;
    height: 480px;
    transform-style: preserve-3d;
}

.player-card-fan {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), 
                opacity 0.6s ease, 
                filter 0.6s ease;
    cursor: pointer;
    transform-origin: center center;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    background: var(--v3-card);
    border: 1px solid rgba(255,255,255,0.1);
}

/* Stany kart */
.player-card-fan.is-active {
    transform: translate(-50%, -50%) scale(1);
    z-index: 10;
    opacity: 1;
    filter: brightness(1);
    box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 0 0 2px rgba(255,45,120,0.5);
}

.player-card-fan.is-prev {
    transform: translate(calc(-50% - 220px), -50%) scale(0.85);
    z-index: 5;
    opacity: 0.6;
    filter: brightness(0.4);
}

.player-card-fan.is-next {
    transform: translate(calc(-50% + 220px), -50%) scale(0.85);
    z-index: 5;
    opacity: 0.6;
    filter: brightness(0.4);
}

.player-card-fan.is-hidden-left {
    transform: translate(calc(-50% - 400px), -50%) scale(0.6);
    z-index: 1;
    opacity: 0;
    pointer-events: none;
}

.player-card-fan.is-hidden-right {
    transform: translate(calc(-50% + 400px), -50%) scale(0.6);
    z-index: 1;
    opacity: 0;
    pointer-events: none;
}

/* Zawartosc karty (skopiowana z poprzedniej wersji) */
.player-card-fan .player-v3-photo {
    width: 100%;
    height: 75%;
    position: relative;
}
.player-card-fan .player-v3-photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
}
.player-card-fan .player-v3-number {
    position: absolute;
    top: 10px; right: 15px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255,255,255,0.2);
}
.player-card-fan .player-v3-info {
    padding: 1.2rem;
    text-align: center;
    position: absolute;
    bottom: 0; width: 100%;
    background: linear-gradient(to top, var(--v3-card) 80%, transparent);
}
.player-card-fan .player-v3-pos {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v3-pink);
    margin-bottom: 0.2rem;
