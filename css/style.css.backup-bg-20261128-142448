/* ============================================================
   SLIDER CSS (animacja automatyczna)
   ============================================================ */

.hero-slide {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 20%;
  opacity: 0;
  animation: fadeSlider 10s infinite;
}

.slide-1 {
  animation-delay: 0s;
}

.slide-2 {
  animation-delay: 5s;
}

@keyframes fadeSlider {
  0% { opacity: 0; }
  5% { opacity: 0.6; }  /* Plynne pojawienie */
  45% { opacity: 0.6; } /* Trzymanie zdjecia */
  55% { opacity: 0; }   /* Zanikanie */
  100% { opacity: 0; }
}





